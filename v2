function settleSplit(results){
 if(results.length===1)return {status:results[0],fraction:results[0]==='win'?1:results[0]==='push'?0:-1};
 const key=results.join('|');
 if(key==='win|win')return {status:'win',fraction:1};
 if(key==='push|push')return {status:'push',fraction:0};
 if(results.includes('win')&&results.includes('push'))return {status:'half-win',fraction:.5};
 if(results.includes('win')&&results.includes('lose'))return {status:'push',fraction:0};
 if(results.includes('push')&&results.includes('lose'))return {status:'half-loss',fraction:-.5};
