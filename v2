}
function settleHandicap(m,parts,side){
 const fs=finalScoresFor(m);if(!fs||!parts||!parts.length)return null;
 const margin=side==='away'?fs.away-fs.home:fs.home-fs.away;
 const legs=parts.map(p=>{const z=margin+p;return z>1e-9?'win':Math.abs(z)<=1e-9?'push':'lose'});
 const s=settleSplit(legs);s.detail=`FINAL ${fs.home}-${fs.away} · ${side==='away'?'visitante':'local'} ${fmtAsianParts(parts)} · ${legs.join(' + ')}`;return s;
}
function settleTotal(m,parts,side){
